<!HTML CODE WITH CSS AND JAVASCRIPT FOR WEATHER DASHBOARD -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weather Dashboard</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            transition: background-color 0.5s ease;
        }
        .container {
            max-width: 400px;
            margin: 50px auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
            background: white;
        }
        select, button {
            width: 80%;
            padding: 10px;
            margin-bottom: 10px;
        }
        .weather-info {
            margin-top: 20px;
        }
        .weather-icon {
            width: 50px;
            height: 50px;
        }
        .time {
            font-size: 18px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Weather Dashboard</h2>
        <select id="citySelect">
            <option value="Chennai">Chennai</option>
            <option value="Delhi">Delhi</option>
            <option value="Mumbai">Mumbai</option>
            <option value="Kolkata">Kolkata</option>
            <option value="Bangalore">Bangalore</option>
            <option value="Hyderabad">Hyderabad</option>
        </select>
        <button onclick="showWeather()">Show Weather</button>
        <div class="weather-info" id="weatherInfo"></div>
        <div class="time" id="currentTime"></div>
    </div>
    
    <script>
        const weatherData = {
            "Chennai": { temp: 32, condition: "Sunny", color: "skyblue", icon: "☀️" },
            "Delhi": { temp: 20, condition: "Cloudy", color: "gray", icon: "☁️" },
            "Mumbai": { temp: 28, condition: "Rainy", color: "lightblue", icon: "🌧️" },
            "Kolkata": { temp: 25, condition: "Thunderstorm", color: "darkgray", icon: "⛈️" },
            "Bangalore": { temp: 22, condition: "Partly Cloudy", color: "lightgray", icon: "🌤️" },
            "Hyderabad": { temp: 30, condition: "Hot", color: "orange", icon: "🔥" }
        };
        
        function showWeather() {
            const city = document.getElementById("citySelect").value;
            const weather = weatherData[city];
            
            document.getElementById("weatherInfo").innerHTML = `
                <h3>${city}</h3>
                <p>${weather.icon}</p>
                <p>Temperature: ${weather.temp}°C</p>
                <p>Condition: ${weather.condition}</p>
            `;
            
            document.body.style.backgroundColor = weather.color;
            updateTime();
        }
        
        function updateTime() {
            const now = new Date();
            const timeString = now.toLocaleTimeString();
            document.getElementById("currentTime").innerText = `Current Time: ${timeString}`;
        }
    </script>
</body>
</html>
